{
  "run": {"run_id": "local", "branch": "main"},
  "models": {
    "text":   {"model": "qwen-plus", "temperature": 0.3, "max_tokens": 25600, "timeout_s": 10},
    "judge":  {"model": "qwen3.8-max", "temperature": 0.0, "max_tokens": 25600, "timeout_s": 45},
    "verify": {"model": "doubao-seed-2-1-pro-260628", "temperature": 0.0, "max_tokens": 25600, "timeout_s": 45},
    "plan":   {"model": "doubao-seed-2-1-pro-260628", "temperature": 0.0, "max_tokens": 4096, "timeout_s": 45, "thinking": false},
    "json_mode": true
  },
  "prompt": {"registry": null},
  "retry": {
    "eval_grader_format_attempts": 2, "brain_max_attempts": 2, "perception_max_retries": 3, "backoff_s": 1.0, "timeout_backoff_s": 2.0},
  "request_timeouts_s": {"choose": 25, "judge": 60, "verify": 60, "summarize": 60},
  "action_limits": {"max_segments": 4, "max_times": 8},
  "loop": {
    "act_stall_limit": 5,
    "episode_stall_limit": 3,
    "run_stall_limit": 3,
    "episode_max_tasks_per_plan": 5,
    "plan_max_new_goals": 3,
    "episode_recursion_limit": 20000,
    "run_recursion_limit": 200000
  },
  "budget": {
    "max_episodes": 10,
    "max_total_actions": null,
    "wall_clock_s": null,
    "reserve_s": 60,
    "episode_max_tasks": 6,
    "max_decompositions": 12,
    "max_planning_rounds": 20,
    "task_max_steps": 12,
    "min_request_s": 3
  },
  "memory": {
    "recall_limit": 5,
    "scope_image_cap": 20,
    "rrf_k": 60,
    "fuse_multiplier": 3,
    "fuse_floor": 10,
    "embedding_model": "BAAI/bge-small-zh-v1.5",
    "reranker_model": "BAAI/bge-reranker-base"
  },
  "review": {
    "mode": "off",
    "link_url": "ws://127.0.0.1:8765",
    "link_lost_timeout_s": 120.0,
    "layers": ["run", "episode"],
    "ai_inject_max_rounds": 3,
    "ai_countdown_s": 30,
    "agent_max_tool_calls": 6,
    "agent_turn_budget_s": 90,
    "agent_model": "deepseek-flash",
    "agent_base_url": "https://api.deepseek.com"
  },
  "trace": {"backend": "local"},
  "checkpoint": {"enabled": true},
  "paths": {"runs_root": ".", "trace": "tracelog", "memory": "memory", "checkpoint": "checkpoints", "config_snapshot": "config_snapshots"},
  "services": {"memory_server_url": null, "world_server_url": null},
  "debug": {"vision_dump_dir": null},
  "eval": null
}
